# ============================================================================
# Environment Configuration
# ============================================================================
# Copy this file to .env and replace placeholder values with your own.
# NEVER commit .env to version control.
# ============================================================================

# AWS Credentials
# Provide IAM credentials with permissions to manage S3, SQS, Lambda,
# CloudWatch, and IAM resources.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder

# Project Identifiers
# A short, unique string appended to all resource names to avoid
# global naming collisions (e.g. your initials and a date: sd-20261006).
UNIQUE_ID=your-initials-date

# DLQ Testing
# Uploading a file with this exact key triggers an intentional processing
# failure, exercising the Dead-Letter Queue redrive logic.
SIMULATE_ERROR_KEY=error-file.json
